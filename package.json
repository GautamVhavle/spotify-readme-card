{
  "name": "spotify-readme-card",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless Spotify now-playing SVG cards for GitHub READMEs",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "authorize": "node scripts/authorize.mjs",
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc --outDir .build --noEmit false",
    "test": "npm run build:test && node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vercel/node": "^5.1.6",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
